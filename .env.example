# Copy to .env (repo root) and fill in. Never commit the real .env.

# --- Core (required) ---
MONGO_URI=""
DB_NAME="elevatr_db"
JWT_SECRET=""

# --- LLM provider (backend/llm.py) ---
LLM_PROVIDER="ollama"              # "ollama" (local, default) or "openai"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL_LARGE="llama3.2:3b"   # planner, interview feedback, eval judge
OLLAMA_MODEL_SMALL="llama3.2:3b"   # cheap extraction
OPENAI_API_KEY=""                  # only needed when LLM_PROVIDER="openai"

# --- Interview simulator ---
GOOGLE_API_KEY=""              # Google Cloud Natural Language (sentiment); NLP_KEY also accepted
VITE_AZURE_SPEECH_KEY=""       # Azure speech-to-text in the browser
VITE_AZURE_SPEECH_REGION="eastus"

# --- Job search sources ---
ADZUNA_API_KEY=""
ADZUNA_APP_ID=""
USAJOBS_API_KEY=""
USAJOBS_USER_AGENT=""          # your email, required by USAJOBS

# --- Optional (RedisChatMemory exists in database.py but MongoChatMemory is the active backend) ---
REDIS_HOST=""
REDIS_PORT=""
REDIS_USER=""
REDIS_PASS=""
